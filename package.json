{
  "name": "image-translation-layer",
  "version": "1.0.0",
  "description": "Comic translation proxy — translates HTML text and image text overlays on-the-fly",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/server.js",
    "dev": "npm run build && node --watch dist/server.js",
    "dev:ts": "tsc --watch"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.62",
    "cheerio": "^1.0.0",
    "express": "^4.21.0",
    "google-translate-api-x": "^10.7.1",
    "sharp": "^0.33.5",
    "tesseract.js": "^5.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3"
  }
}
